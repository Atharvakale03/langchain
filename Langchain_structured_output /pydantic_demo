from pydantic import BaseModel,EmailStr,Field
from typing import Optional

class Student(BaseModel):

    name: str = 'sam'  # Default value is 'sam'
    age : Optional[int] = None  # Optional field, can be None or int
    email: EmailStr
    cgpa: float= Field(gt=0, lt=10, default=5, description= 'A decimal value representing the cgpa of stuent') #we can also set here default value



new_student = {'age': '32', 'email': 'abc@gmail.com'}  # here name should be str, but we provide an int so it will validate and give error as similar to TypedDict but there is no validation over there 


student = Student(**new_student)

print(student)
